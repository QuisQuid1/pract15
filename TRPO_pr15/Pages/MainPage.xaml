<Page x:Class="TRPO_pr15.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TRPO_pr15.Pages"
      xmlns:validation="clr-namespace:TRPO_pr15.Validations"
      xmlns:MaterialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"   
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Товары">
    <Grid Background="#dfeaeb">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="90"/>
            <RowDefinition/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" 
                   Text="Товары магазина" 
                   FontSize="24" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Label>Поиск</Label>
                    <TextBox Text="{Binding service.searchQuery, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_TextChanged">
                        <MaterialDesign:HintAssist.Hint>
                            Введите текст для поиска
                        </MaterialDesign:HintAssist.Hint>
                    </TextBox>
                </StackPanel>
                <Grid x:Name="IsModerator" Grid.Column="1" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Button Click="AddProductButton_Click" Grid.Row="1">Добавить товар</Button>
                    <Button Click="EditProductButton_Click" Grid.Row="1" Grid.Column="1">Редактировать товар</Button>
                    <Button Click="RemoveProductButton_Click" Grid.Row="1" Grid.Column="2">Удалить товар</Button>
                    <Button Click="CategoryButton_Click" Grid.Row="0">Категории</Button>
                    <Button Click="BrandButton_Click" Grid.Row="0" Grid.Column="1">Бренды</Button>
                    <Button Click="TagtButton_Click" Grid.Row="0" Grid.Column="2">Теги</Button>
                </Grid>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Grid.Column="0">
                <Label>Сортировка</Label>
                <ComboBox SelectionChanged="ComboBox_SelectionChanged">
                    <ComboBoxItem Tag="Name" Content="По наименованию"/>
                    <ComboBoxItem Tag="PriceDescending" Content="По цене (убывание)"/>
                    <ComboBoxItem Tag="PriceAscending" Content="По цене (возрастание)"/>
                    <ComboBoxItem Tag="StockDescending" Content="По количеству (убывание)"/>
                    <ComboBoxItem Tag="StockAscending" Content="По количеству (возрастание)"/>
                </ComboBox>

                <StackPanel>
                    <StackPanel>
                        <Label>Фильтр по категории</Label>
                        <TextBox Text ="{Binding service.categoryName, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_TextChanged" x:Name="CategoryName"/>
                    </StackPanel>
                    <StackPanel>
                        <Label>Фильтр по бренду</Label>
                        <TextBox Text="{Binding service.brandName, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_TextChanged" x:Name="BrandName"/>
                    </StackPanel>
                    <StackPanel>
                        <Label>Фильтр по цене</Label>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label>от</Label>
                            <TextBox TextChanged="TextBox_TextChanged" x:Name="PriceLow" Grid.Row="6" Grid.Column="1">
                                <TextBox.Text>
                                    <Binding Path ="service.filterPriceFrom" UpdateSourceTrigger="PropertyChanged">
                                        <Binding.ValidationRules>
                                            <validation:DecimalValidation/>
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Label>до</Label>
                                <TextBox TextChanged="TextBox_TextChanged" x:Name="PriceHigh" Grid.Row="6" Grid.Column="1">
                                    <TextBox.Text>
                                    <Binding Path ="service.filterPriceTo" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <validation:DecimalValidation/>
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </TextBox.Text>
                                </TextBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
                <Button Margin="5" Click="ResetButton_Click">Сбросить</Button>
            </StackPanel>

            <MaterialDesign:ColorZone Grid.Row="2" Grid.Column="1" Mode="SecondaryMid">
                <ListView x:Name="ProductsList" 
                         HorizontalContentAlignment="Stretch" 
                         ItemsSource="{Binding service.productsView}" 
                         SelectedItem="{Binding product}"
                         Background="White">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="ProductBorder" 
                                    BorderThickness="2" 
                                    Padding="10" 
                                    Margin="5"
                                    CornerRadius="5"
                                    Background="White">
                                <Border.Resources>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Stock}" Value="9">
                                                <Setter Property="BorderBrush" Value="#ffd129"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Stock}" Value="8">
                                                <Setter Property="BorderBrush" Value="#ffd129"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Stock}" Value="7">
                                                <Setter Property="BorderBrush" Value="#ffd129"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Stock}" Value="6">
                                                <Setter Property="BorderBrush" Value="#ffd129"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Stock}" Value="5">
                                                <Setter Property="BorderBrush" Value="#ffd129"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Stock}" Value="4">
                                                <Setter Property="BorderBrush" Value="#ffd129"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Stock}" Value="3">
                                                <Setter Property="BorderBrush" Value="#ffd129"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Stock}" Value="2">
                                                <Setter Property="BorderBrush" Value="#ffd129"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Stock}" Value="1">
                                                <Setter Property="BorderBrush" Value="#ffd129"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Stock}" Value="0">
                                                <Setter Property="BorderBrush" Value="#ffd129"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Resources>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                    <TextBlock Text="{Binding Name}"
                                                   FontWeight="Bold" 
                                                   FontSize="16"
                                                   Foreground="Black"/>

                                <StackPanel Orientation="Horizontal" Grid.Row="1">
                                            <TextBlock>
                                                <Run Text="⭐Рейтинг "/>
                                                <Run Text="{Binding Rating}"/>
                                            </TextBlock>
                                        </StackPanel>

                                <TextBlock Grid.Row="2">
                                            <Run Text="Категория "/>
                                            <Run Text="{Binding Category.Name}"/>
                                        </TextBlock>

                                <TextBlock Grid.Row="3"
                                                   TextWrapping="Wrap">
                                <Run Text="Описание "/>
                                <Run Text="{Binding Description}"/>
                                </TextBlock>

                                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
                                        <ItemsControl ItemsSource="{Binding Tags}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="0,0,5,0">
                                                        <Run Text="#"/>
                                                        <Run Text="{Binding Name}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock HorizontalAlignment="Right">
                                        <Run Text="Цена "/>
                                        <Run Text="{Binding Price, StringFormat={}{0:F2}}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock HorizontalAlignment="Right">
                                        <Run Text="Остаток: "/>
                                        <Run Text="{Binding Stock}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </MaterialDesign:ColorZone>

        <WrapPanel Grid.Row="3" Grid.ColumnSpan="2">
            <TextBlock Text="{Binding service.Products.Count, StringFormat='{}Всего товаров: {0}'}" 
                       Margin="0,0,20,0"
                       FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Items.Count, ElementName=ProductsList, StringFormat='{}Показано товаров: {0}'}" 
                       FontWeight="SemiBold"/>
        </WrapPanel>
    </Grid>
</Page>
